# 复制为 .env 后填写（本地调试用；线上在平台面板里配环境变量，不要提交 .env）

# 数据库：本地留空即用 SQLite(server/wyzb.db)；
# 线上必须换成 Postgres 连接串（Render/Koyeb 免费档的文件系统是临时的，SQLite 会丢数据）
# Neon 例：postgresql://user:pass@ep-xxx.neon.tech/neondb
# Supabase 例：postgresql://postgres.xxx:pass@aws-0-xxx.pooler.supabase.com:5432/postgres
DATABASE_URL=

# JWT 签名 + API Key 加密的主密钥。务必换成随机长字符串：
# python -c "import secrets;print(secrets.token_urlsafe(48))"
# 警告：换掉它之后，库里已存的 API Key 会解不开（表现为 Key 丢失，需重新填写）
SECRET_KEY=

# 允许访问的前端来源，逗号分隔；先填 *，上线稳定后改成你的 Pages 域名
ALLOWED_ORIGINS=*

# 注册是否需要邀请码（true/false）
INVITE_REQUIRED=true

# 有权限生成邀请码的账号
ADMIN_USERNAMES=root

# 首次启动写入的预置账号：用户名:密码,用户名:密码
SEED_USERS=root:886260,user:vxea418707

# 首次启动写入的邀请码，逗号分隔，每个只能用一次
SEED_INVITES=helloyao1,helloyao2,helloyao3,helloyao4,helloyao5
