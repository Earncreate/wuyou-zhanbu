<view class="wrap">
  <view class="hero">
    <view class="hero-title">无忧占卜</view>
    <view class="hero-sub">京房纳甲 · 六爻断生活小事</view>
    <view class="hero-gz">{{gz}}</view>
  </view>

  <view class="sec">今日想占哪一桩</view>
  <block wx:for="{{modGroups}}" wx:for-item="grp" wx:key="key">
    <view class="grp-title">{{grp.name}}</view>
    <view class="mod-list {{grp.key !== 'life' ? 'chip-grid' : ''}}">
      <view wx:for="{{grp.mods}}" wx:for-item="item" wx:key="id" class="mod-card {{grp.key !== 'life' ? 'mod-chip' : ''}}"
            data-mod="{{item.id}}" bindtap="onMod"
            style="--mc:{{item.color}};--mc2:{{item.color2}}">
        <view class="mod-icon">{{item.icon}}</view>
        <view class="mod-body">
          <view class="mod-name">{{item.name}}</view>
          <view class="mod-sub">{{item.sub}}</view>
          <view wx:if="{{grp.key === 'life'}}" class="mod-desc">{{item.desc}}</view>
        </view>
        <view wx:if="{{grp.key === 'life'}}" class="mod-arrow">›</view>
      </view>
    </view>
  </block>

  <view class="sec">我的占卦记录<text class="clr" catchtap="clearRecords">清空全部</text></view>
  <view wx:if="{{cloudOn}}" class="sync-tip">已开启云同步：记录同时写入本机与云端（换设备也能看到）</view>
  <view wx:for="{{groups}}" wx:key="id" class="grp" style="--mc:{{item.color}}">
    <view class="grp-h"><text class="gi">{{item.icon}}</text>{{item.name}}记录<text class="gc">{{item.recs.length}}</text></view>
    <view wx:if="{{item.recs.length === 0}}" class="empty">还没有保存的记录，起卦后点「保存此卦」即可存入此处</view>
    <scroll-view wx:else scroll-y class="grp-list" style="max-height:380rpx">
      <view wx:for="{{item.recs}}" wx:for-item="r" wx:key="key" class="rec-row"
            data-idx="{{r.idx}}" data-kind="{{r.kind}}" data-cloud="{{r.cloudId}}" bindtap="onRecord">
        <view class="rec-fig">
          <view wx:for="{{r.fig}}" wx:for-item="ln" wx:key="i" class="rec-ln {{ln.yang ? 'y' : 'n'}}"></view>
        </view>
        <view class="rec-mid">
          <text class="rg">{{r.gua}}<text wx:if="{{r.hasAi}}" class="tag-ai">已存解读</text><text wx:if="{{r.kind === 'cloud'}}" class="tag-cloud">云</text></text>
          <text class="ra">{{r.ask}}</text>
        </view>
        <view class="rt">
          <text class="rt-s">阳历 {{r.solarTxt}}</text>
          <text class="rt-b">{{r.bjTxt}}</text>
        </view>
        <view class="rec-del" catchtap="onDelete" data-idx="{{r.idx}}" data-kind="{{r.kind}}" data-cloud="{{r.cloudId}}">✕</view>
      </view>
    </scroll-view>
  </view>

  <view class="sec">说明</view>
  <view class="card note">
    按传统「三枚铜钱」起卦：三字为老阴×、三背为老阳○、二字一背为少阳、二背一字为少阴，自初爻摇至上爻。装卦依京房纳甲、《卜筮正宗》月建日辰为纲，用《增删卜易》用神理法推演。
  </view>

  <view class="card">
    <view class="btn-main" bindtap="goSet">接口设置</view>
    <view class="sub-tip">两段式解析：① 六爻助手做卦象总断　② 模块顾问深化方案</view>
  </view>
  <view class="pad" />
</view>
