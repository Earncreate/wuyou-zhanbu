<view class="wrap">
  <block wx:if="{{ctx}}">
    <view class="card">
      <view class="ask-line"><text class="k">事项</text><text class="v">{{ctx.icon}} {{ctx.modName}}</text></view>
      <view class="ask-line"><text class="k">问事</text><text class="v">{{ctx.askText}}</text></view>
      <view class="ask-line"><text class="k">卦象</text><text class="v">{{ctx.gua}}　{{ctx.shiYing}}　{{ctx.palace}}</text></view>
      <view class="ask-line"><text class="k">日历</text><text class="v">{{ctx.solar}}　{{ctx.lunar}}　月建{{ctx.yueJian}}　日辰{{ctx.riChen}}</text></view>
    </view>

    <block wx:if="{{!hasKey}}">
      <view class="card nokey">
        <view class="nk-t">尚未配置大模型</view>
        <view class="nk-p">本小程序采用两段式解析：先用「六爻助手」提示词对排盘做卦象总断，再把总断结果连同该模块的专属提示词交给「{{modName}}顾问」深化成落地方案。两段都调用大模型，因此需要先配置接口。</view>
        <view class="btn-main" bindtap="goSetting">去设置</view>
      </view>
    </block>

    <block wx:else>
      <view class="steps-bar">
        <view class="st {{stage > 1 ? 'done' : (stage === 1 ? 'run' : '')}}">① 卦象总断</view>
        <text class="arw">›</text>
        <view class="st {{stage > 2 ? 'done' : (stage === 2 ? 'run' : '')}}">② {{modName}}深化</view>
      </view>

      <block wx:if="{{err}}">
        <view class="card">
          <view class="err-t">调用失败</view>
          <view class="err-m">{{err}}</view>
          <view class="note">常见原因：Key 无效或余额不足、接口地址写错、模型名不匹配。请到设置页核对。</view>
          <view class="btn-main" bindtap="retry">重新解析</view>
        </view>
      </block>

      <block wx:elif="{{stage === 1}}">
        <view class="card"><view class="ai-out blink">① 六爻助手正在推演卦象总断…</view></view>
      </block>

      <block wx:elif="{{stage === 2 && !out}}">
        <view class="card"><view class="ai-out blink">② {{modName}}顾问正在结合总断深化方案…</view></view>
      </block>

      <block wx:else>
        <view class="card"><view class="ai-out">{{out}}</view></view>
        <view class="card fold">
          <view class="fold-t" bindtap="toggleFold">
            {{foldOpen ? '▾' : '▸'}} 幕后：第一阶段「卦象总断」原文
          </view>
          <view wx:if="{{foldOpen}}" class="ai-out">{{stage1}}</view>
        </view>
        <view class="card">
          <view class="btn-main" style="background:#3F6B57" bindtap="save">{{saved ? '已保存 ✓' : '保存此卦'}}</view>
          <view class="btn-main" bindtap="retry">重新解析</view>
          <view class="btn-main" style="background:#6E655A" bindtap="copy">复制结果</view>
        </view>
      </block>

      <view class="card note">以上由「六爻助手 + {{modName}}顾问」两段提示词依次推演，属决策辅助与文化参考，不构成医疗、法律或财务建议。</view>
    </block>
  </block>
  <view class="pad" />
</view>
